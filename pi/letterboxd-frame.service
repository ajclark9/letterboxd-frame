# Template: pi/install.sh fills in @USER@, @REPO@ and @ARGS@ and installs it to
# /etc/systemd/system. Re-run `sudo bash pi/install.sh` instead of copying this by hand.
[Unit]
Description=Letterboxd frame update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
ExecStart=/usr/bin/python3 @REPO@/pi/frame.py @ARGS@
TimeoutStartSec=180
