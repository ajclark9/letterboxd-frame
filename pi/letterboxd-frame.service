[Unit]
Description=Letterboxd frame update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
# Change the URL and --display (fake -> inky or waveshare) when the panel arrives.
ExecStart=/usr/bin/python3 /home/pi/letterboxd-frame/pi/frame.py --url https://ajclark9.github.io/letterboxd-frame/frame.png --display fake
TimeoutStartSec=180
